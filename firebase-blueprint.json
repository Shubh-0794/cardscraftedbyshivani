{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account in Cards Crafted system",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "whatsapp": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "STAFF", "CUSTOMER"] },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "customerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "email", "role", "status", "createdAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer profile and contact information",
      "type": "object",
      "properties": {
        "customerCode": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "whatsapp": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "pincode": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "totalOrders": { "type": "number" },
        "totalSpent": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["customerCode", "name", "email", "whatsapp", "address", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Custom craft order record",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "maxLength": 50 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 20 },
        "customerEmail": { "type": "string", "maxLength": 150 },
        "orderDate": { "type": "string", "maxLength": 50 },
        "expectedDeliveryDate": { "type": "string", "maxLength": 50 },
        "status": { "type": "string" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "tax": { "type": "number" },
        "grandTotal": { "type": "number" },
        "paidAmount": { "type": "number" },
        "balanceAmount": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "priority": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["orderNumber", "customerId", "customerName", "status", "grandTotal", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Product catalog item",
      "type": "object",
      "properties": {
        "sku": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "sellingPrice": { "type": "number" },
        "costPrice": { "type": "number" },
        "taxPercent": { "type": "number" },
        "stockQuantity": { "type": "number" },
        "minStock": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["sku", "name", "category", "sellingPrice", "stockQuantity"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Raw material or inventory stock item",
      "type": "object",
      "properties": {
        "sku": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 150 },
        "category": { "type": "string" },
        "unit": { "type": "string" },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "maxStock": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "purchaseChannel": { "type": "string", "enum": ["ONLINE", "OFFLINE"] },
        "purchasePlatform": { "type": "string", "maxLength": 100 },
        "purchasePlatformOther": { "type": "string", "maxLength": 150 },
        "purchaseOrderRef": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] }
      },
      "required": ["sku", "name", "category", "unit", "currentStock"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment transaction record",
      "type": "object",
      "properties": {
        "paymentCode": { "type": "string", "maxLength": 50 },
        "orderId": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "paymentDate": { "type": "string", "maxLength": 50 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["paymentCode", "orderId", "amount", "method", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System activity log",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "action": { "type": "string", "maxLength": 100 },
        "entity": { "type": "string", "maxLength": 100 },
        "entityId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "action", "entity", "createdAt"]
    },
    "Settings": {
      "title": "Settings",
      "description": "System and company configuration settings",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "maxLength": 150 },
        "businessName": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 150 },
        "gstin": { "type": "string", "maxLength": 30 }
      },
      "required": ["businessName"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Customer and system notifications",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string" },
        "orderId": { "type": "string", "maxLength": 128 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["title", "message", "type", "createdAt"]
    },
    "CustomerAddress": {
      "title": "CustomerAddress",
      "description": "Customer saved shipping and delivery addresses",
      "type": "object",
      "properties": {
        "customerId": { "type": "string", "maxLength": 128 },
        "tag": { "type": "string", "maxLength": 50 },
        "fullName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "addressLine": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "pincode": { "type": "string", "maxLength": 10 },
        "isPrimary": { "type": "boolean" }
      },
      "required": ["customerId", "fullName", "phone", "addressLine", "city", "state", "pincode"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Customer saved wishlist craft products",
      "type": "object",
      "properties": {
        "customerId": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "price": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 }
      },
      "required": ["customerId", "productId", "name", "price"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer list"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Orders collection"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Product catalog"
    },
    "/inventory/{inventoryId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Inventory items"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Payment transactions"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "System and customer notifications"
    },
    "/addresses/{addressId}": {
      "schema": { "$ref": "#/entities/CustomerAddress" },
      "description": "Customer delivery addresses"
    },
    "/wishlists/{wishlistId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "Saved customer wishlist items"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "System audit logs"
    },
    "/settings/company": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Company configuration"
    }
  }
}
